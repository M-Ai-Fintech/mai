    "team_key": "MAI",
    "migration_map": "docs/migrations/backlog-to-linear-map.json",
    "legacy_system": "Backlog.md"
  },
  "policy": "prompts/OPERATING_RULES.md",
  "prompt_format": {
    "terminal": "/goal",
    "terminal_must_be_last_nonblank_line": true,
    "task_sections": [
      "Context",
      "Objective",
      "Relevant scope / architecture",
      "Known risks or constraints",
      "Expected verification",
      "Allowed state transitions",
      "/goal"
    ],
    "role_prompts_use_same_lean_order": true,
    "stable_policy_must_not_be_duplicated": true,
    "current_identifiers": "Linear",
    "legacy_identifiers": "historical-traceability-only"
  },
  "models": {
    "substantial_implementation": "5.6 Luna Max",
    "small_or_mechanical": "5.6 Luna Medium",
    "coordination_without_implementation": "5.6 Terra Medium",
    "deep_architecture_security_or_planning": "Sol (explicit justification required)",
    "runtime_identity_authority": "execution-selected model"
  },
  "fast_mode": {
    "default": true,
    "surfaces": ["implementation", "debugging", "diagnosis", "interactive-correction"],
    "repository_control": false,
    "scope_effect": "latency only"
  },
  "agent_policy": {
    "default": "one-accountable-agent",
    "delegation": "only when genuinely separable and materially faster",
    "independent_review_swarm": false,
    "automatic_model_substitution": false
  },
  "graphify_policy": "Run graphify only at the explicitly authorized repository stage; policy and implementation prompts use focused repository inspection unless the task explicitly authorizes a refresh.",
  "subagents": {
    "enabled": true,
    "goal_command": "/goal",
    "coordination": "single-task-coordinator",
    "scratch_worktrees": true,
    "patch_only_handoffs": true,
    "default_max_subagents": 0,
    "default_max_writers": 0,
    "requires_coordinator_justification": true,
    "override_activation": "Capacity is not permission; activate an override only after the coordinator records separability, ownership, integration order, and material elapsed-time benefit.",
    "single_authoritative_branch": true,
    "single_authoritative_pr": true,
    "single_linear_writer": true,
    "single_graphify_writer": true,
    "serial_integration": true
  },
