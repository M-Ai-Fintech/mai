{
  "name": "gui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "verify:tokens": "npm run tokens:check && node scripts/verify-design-tokens.mjs",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:screens": "node scripts/verify-screens.mjs",
    "verify:deal-screens": "node scripts/verify-deal-screens.mjs",
    "verify:execution-screens": "node scripts/verify-execution-screens.mjs",
    "verify:conformance": "node scripts/verify-frontend-conformance.mjs",
    "verify:workflows": "node scripts/verify-frontend-workflows.mjs",
    "verify:foundation": "node scripts/verify-frontend-foundation.mjs",
    "validate:storybook-docs": "node scripts/validate-storybook-docs.mjs",
    "test-storybook": "vitest --project=storybook",
    "test-storybook:update": "vitest --project=storybook --update"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "aria-query": "5.3.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-storybook": "^10.5.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
