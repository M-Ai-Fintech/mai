{
  "$schema": "../schemas/mai-148-infrastructure-plan.schema.json",
  "task": "MAI-148",
  "environment": "production",
  "approval": {
    "state": "pending",
    "provider": null,
    "regions": [],
    "accountProject": null,
    "availability": null,
    "rpoMinutes": null,
    "rtoMinutes": null,
    "securityControls": [],
    "approvers": [],
    "approvedAt": null
  },
  "providerAdapter": null,
  "stateBackend": {
    "type": "planned-remote",
    "stateNamespace": "mai-production",
    "accessControl": true,
    "locking": true,
    "backup": true,
    "recoveryProcedure": "infra/runbooks/backup-restore.md"
  },
  "topology": {
    "name": "modular-monolith",
    "eventTransport": "database-outbox-inbox",
    "processes": [
      {
        "name": "api",
        "owner": "platform-runtime",
        "command": "deno task api:start",
        "healthPath": "/health/live",
        "readinessPath": "/health/ready",
        "cpuMillicores": 500,
        "memoryMiB": 512,
        "timeoutSeconds": 30,
        "concurrency": 20,
        "minReplicas": null,
        "maxReplicas": null,
        "shutdownGraceSeconds": 30,
        "drainSeconds": 15,
        "scalingRationale": "Production scaling requires measured latency, availability, and capacity approval."
      },
      {
        "name": "worker",
        "owner": "platform-jobs",
        "command": "deno task worker:start",
        "healthPath": "/health/live",
        "readinessPath": "/health/ready",
        "cpuMillicores": 500,
        "memoryMiB": 512,
        "timeoutSeconds": 900,
        "concurrency": 4,
        "minReplicas": null,
        "maxReplicas": null,
        "shutdownGraceSeconds": 60,
        "drainSeconds": 45,
        "scalingRationale": "Production scaling requires durable-job backlog, lease, and failure-boundary approval."
      }
    ]
  },
  "database": {
    "engine": "postgresql",
    "management": "managed-postgresql",
    "environmentDatabase": "mai_production",
    "connectivity": "approved-private",
    "automatedBackups": true,
    "pointInTimeRecovery": true,
    "migrationStrategy": "pre-traffic",
    "runtimeOwnsMigrations": false,
    "authoritativeData": [
      "platform.outbox",
      "platform.inbox",
      "platform.jobs",
      "audit",
      "evidence"
    ],
    "restoreProcedure": "infra/runbooks/backup-restore.md"
  },
  "objectStorage": {
    "keyTemplate": "{environment}/{tenant}/{workspace}/{deal}/{object}/{version}",
    "environmentBoundary": true,
    "tenantBoundary": true,
    "versioning": true,
    "lifecyclePolicy": "approve class-specific lifecycle before provisioning",
    "retentionPolicy": "approve retention, residency, and legal-hold policy before provisioning",
    "legalHoldCompatible": true,
    "deletionBehavior": "approval-controlled",
    "encryptionControl": "approved-key-management",
    "classifications": ["source", "quarantine", "generated", "release", "audit"]
  },
  "secrets": {
    "manager": "approved-secrets-manager-required",
    "longLivedCredentialsAllowed": false,
    "ciCredentialMode": "workload-identity-federation",
    "outputRedaction": true
  },
  "network": {
    "publicIngress": "api-only",
    "privateConnectivity": "approved",
    "egress": "allowlisted",
    "administrativeAccess": "private-only",
    "serviceToService": "internal-only"
  },
  "iam": {
    "workloadIdentity": true,
    "runtimeRoles": ["api-runtime-minimal", "worker-runtime-minimal"],
    "separateMigrationRole": true,
    "broadProductionGrant": false
  },
  "observability": {
    "structuredLogs": true,
    "metrics": true,
    "traces": true,
    "correlationIds": true,
    "dashboards": [
      "api-runtime",
      "worker-runtime",
      "database",
      "storage",
      "deployment"
    ],
    "alerts": [
      "health-failure",
      "worker-backlog",
      "database-capacity",
      "unexpected-spend"
    ],
    "auditAccess": "approved-operator-read-only",
    "sensitiveFieldRedaction": true,
    "secretRedaction": true
  },
  "costControls": {
    "budgetControl": true,
    "costAttribution": "production-environment-required",
    "alertThresholdPercent": 80,
    "capacityThresholds": [
      "cpu-80-percent",
      "memory-80-percent",
      "job-backlog-threshold"
    ],
    "unexpectedSpendAlerts": true
  },
  "migration": {
    "owner": "migration-runner",
    "strategy": "pre-traffic",
    "runtimeOwnsMigrations": false,
    "rollback": "stop traffic and retain authoritative rows"
  },
  "cloudTransport": {
    "enabled": false,
    "interface": "src/platform/events/v1.ts",
    "retryPolicy": "consumer-owned at-least-once retry",
    "deadLetterPolicy": "platform job dead-letter state",
    "idempotencyPolicy": "inbox provider-event identity"
  },
  "recovery": {
    "protectedRecords": [
      "database",
      "platform.outbox",
      "platform.inbox",
      "platform.jobs",
      "audit",
      "evidence",
      "object-storage"
    ],
    "rollbackDeletesAuthoritativeData": false,
    "smokeStatus": "not-executed",
    "restartRecoveryStatus": "not-executed",
    "backupRestoreStatus": "not-executed",
    "rollbackStatus": "not-executed"
  },
  "readinessClaim": "not-ready"
}
