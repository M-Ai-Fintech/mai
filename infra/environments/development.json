{
  "$schema": "../schemas/mai-148-infrastructure-plan.schema.json",
  "task": "MAI-148",
  "environment": "development",
  "approval": {
    "state": "not-required",
    "provider": "docker-local",
    "regions": ["local"],
    "accountProject": "local",
    "availability": "single-node-local-test",
    "rpoMinutes": 1440,
    "rtoMinutes": 240,
    "securityControls": ["local-network-isolation", "secret-redaction"],
    "approvers": ["local-test-contract"],
    "approvedAt": null
  },
  "providerAdapter": "local-compose",
  "stateBackend": {
    "type": "local-only",
    "stateNamespace": "mai148-development-local",
    "accessControl": true,
    "locking": true,
    "backup": true,
    "recoveryProcedure": "infra/runbooks/backup-restore.md"
  },
  "topology": {
    "name": "modular-monolith",
    "eventTransport": "database-outbox-inbox",
    "processes": [
      {
        "name": "api",
        "owner": "platform-runtime",
        "command": "deno task api:start",
        "healthPath": "/health/live",
        "readinessPath": "/health/ready",
        "cpuMillicores": 500,
        "memoryMiB": 512,
        "timeoutSeconds": 30,
        "concurrency": 20,
        "minReplicas": 1,
        "maxReplicas": 1,
        "shutdownGraceSeconds": 30,
        "drainSeconds": 15,
        "scalingRationale": "HTTP request latency and ingress failure boundary."
      },
      {
        "name": "worker",
        "owner": "platform-jobs",
        "command": "deno task worker:start",
        "healthPath": "/health/live",
        "readinessPath": "/health/ready",
        "cpuMillicores": 500,
        "memoryMiB": 512,
        "timeoutSeconds": 900,
        "concurrency": 4,
        "minReplicas": 1,
        "maxReplicas": 1,
        "shutdownGraceSeconds": 60,
        "drainSeconds": 45,
        "scalingRationale": "Durable database-backed jobs need an independent failure and concurrency boundary."
      }
    ]
  },
  "database": {
    "engine": "postgresql",
    "management": "managed-postgresql",
    "environmentDatabase": "mai148_development",
    "connectivity": "local-only",
    "automatedBackups": true,
    "pointInTimeRecovery": true,
    "migrationStrategy": "pre-traffic",
    "runtimeOwnsMigrations": false,
    "authoritativeData": [
      "platform.outbox",
      "platform.inbox",
      "platform.jobs",
      "audit",
      "evidence"
    ],
    "restoreProcedure": "infra/runbooks/backup-restore.md"
  },
  "objectStorage": {
    "keyTemplate": "{environment}/{tenant}/{workspace}/{deal}/{object}/{version}",
    "environmentBoundary": true,
    "tenantBoundary": true,
    "versioning": true,
    "lifecyclePolicy": "class-specific lifecycle is required before deployment",
    "retentionPolicy": "retention and legal hold are metadata-controlled",
    "legalHoldCompatible": true,
    "deletionBehavior": "approval-controlled",
    "encryptionControl": "local-only",
    "classifications": ["source", "quarantine", "generated", "release", "audit"]
  },
  "secrets": {
    "manager": "local-environment-secret-store",
    "longLivedCredentialsAllowed": false,
    "ciCredentialMode": "workload-identity-federation",
    "outputRedaction": true
  },
  "network": {
    "publicIngress": "local-only",
    "privateConnectivity": "local-only",
    "egress": "local-only",
    "administrativeAccess": "local-only",
    "serviceToService": "local-only"
  },
  "iam": {
    "workloadIdentity": true,
    "runtimeRoles": ["api-runtime-minimal", "worker-runtime-minimal"],
    "separateMigrationRole": true,
    "broadProductionGrant": false
  },
  "observability": {
    "structuredLogs": true,
    "metrics": true,
    "traces": true,
    "correlationIds": true,
    "dashboards": ["local-runtime"],
    "alerts": ["local-process-exit"],
    "auditAccess": "operator-read-only",
    "sensitiveFieldRedaction": true,
    "secretRedaction": true
  },
  "costControls": {
    "budgetControl": true,
    "costAttribution": "local-development",
    "alertThresholdPercent": 80,
    "capacityThresholds": ["cpu-80-percent", "memory-80-percent"],
    "unexpectedSpendAlerts": true
  },
  "migration": {
    "owner": "migration-runner",
    "strategy": "pre-traffic",
    "runtimeOwnsMigrations": false,
    "rollback": "stop traffic and retain authoritative rows"
  },
  "cloudTransport": {
    "enabled": false,
    "interface": "src/platform/events/v1.ts",
    "retryPolicy": "consumer-owned at-least-once retry",
    "deadLetterPolicy": "platform job dead-letter state",
    "idempotencyPolicy": "inbox provider-event identity"
  },
  "recovery": {
    "protectedRecords": [
      "database",
      "platform.outbox",
      "platform.inbox",
      "platform.jobs",
      "audit",
      "evidence",
      "object-storage"
    ],
    "rollbackDeletesAuthoritativeData": false,
    "smokeStatus": "not-executed",
    "restartRecoveryStatus": "not-executed",
    "backupRestoreStatus": "not-executed",
    "rollbackStatus": "not-executed"
  },
  "readinessClaim": "not-ready"
}
