{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.invalid/schemas/mvp-local-operations.schema.json",
  "title": "MVP local operations contract",
  "description": "Local/containerized deployment contract. It is not cloud, staging, production, or provider-certification evidence.",
  "type": "object",
  "required": [
    "contract",
    "environment",
    "approval",
    "providerAdapter",
    "stateBackend",
    "topology",
    "database",
    "objectStorage",
    "secrets",
    "network",
    "iam",
    "observability",
    "costControls",
    "migration",
    "cloudTransport",
    "recovery",
    "readinessClaim"
  ],
  "properties": {
    "contract": { "const": "mvp-local-v1" },
    "environment": { "const": "local" },
    "approval": { "type": "object" },
    "providerAdapter": { "const": "local-compose" },
    "stateBackend": { "type": "object" },
    "topology": { "type": "object" },
    "database": { "type": "object" },
    "objectStorage": { "type": "object" },
    "secrets": { "type": "object" },
    "network": { "type": "object" },
    "iam": { "type": "object" },
    "observability": { "type": "object" },
    "costControls": { "type": "object" },
    "migration": { "type": "object" },
    "cloudTransport": { "type": "object" },
    "recovery": { "type": "object" },
    "readinessClaim": { "const": "local-only" }
  },
  "additionalProperties": false
}
