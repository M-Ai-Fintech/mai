{
  "tasks": {
    "api:start": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-run src/api/server.ts",
    "worker:start": "deno run --env --allow-read --allow-env --allow-net src/platform/jobs/worker_process.ts",
    "test": "DENO_ENV=test deno test --env --allow-read --allow-write --allow-env --allow-ffi --allow-run --allow-net",
    "test:infra": "DENO_ENV=test deno test --env --allow-read --allow-env --allow-ffi --allow-net tests/platform/operations/*.spec.ts tests/platform/jobs/worker_process.spec.ts",
    "infra:validate": "deno run --allow-read scripts/infra_validate.ts",
    "infra:smoke": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys scripts/infra_smoke.ts",
    "infra:bootstrap": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-run scripts/infra_bootstrap.ts",
    "local:prepare": "deno run --allow-read --allow-write scripts/local_env.ts",
    "db:migrate": "deno run --env --allow-read --allow-env --allow-net scripts/migrate.ts",
    "infra:backup": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-run scripts/infra_recovery.ts backup",
    "infra:restore": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-run scripts/infra_recovery.ts restore",
    "infra:rollback": "deno run --env --allow-read --allow-env --allow-net --allow-run scripts/infra_rollback.ts",
    "preflight": "deno run --env --allow-read --allow-write=.local --allow-env --allow-net --allow-run scripts/preflight.ts --json",
    "prepare": "deno run --env --allow-read --allow-write=.local --allow-env --allow-net --allow-run scripts/preflight.ts --prepare",
    "verify": "deno run --env --allow-env --allow-read --allow-net --allow-run scripts/verify.ts",
    "verify:fast": "deno run --cached-only --frozen --allow-read=. --allow-run=deno --no-prompt scripts/verify_fast.ts",
    "verify:fast:benchmark": "deno run --cached-only --frozen --allow-read=. --allow-run=deno --no-prompt scripts/verify_fast_benchmark.ts",
    "verify:integration": "deno run --allow-env --allow-net --allow-ffi --allow-sys scripts/verify_integration.ts",
    "test:smoke": "deno test --env --allow-read --allow-write --allow-env --allow-ffi --allow-run --allow-net tests/smoke.spec.ts",
    "db:start": "docker compose up -d postgres-integration-test",
    "db:stop": "docker compose down",
    "db:setup": "deno run --env --allow-read --allow-env --allow-net src/core/db/setup.ts",
    "gui:start": "npm --prefix gui run dev"
  },
  "imports": {
    "@mastra/core": "npm:@mastra/core@^1.0.0",
    "@ai-sdk/google": "npm:@ai-sdk/google@^1.0.0",
    "javascript-lp-solver": "npm:javascript-lp-solver@1.0.3",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "zod": "npm:zod@^3.23.8",
    "@huggingface/transformers": "npm:@huggingface/transformers@^4.2.0",
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "pg": "npm:pg@^8.11.3",
    "@types/pg": "npm:@types/pg@^8.11.4"
  },
  "compilerOptions": {
    "strict": true
  },
  "nodeModulesDir": "auto",
  "test": {
    "include": [
      "tests/**/*.spec.ts",
      "tests/**/*.test.ts",
      "tests/**/*_test.ts",
      "src/**/*.spec.ts",
      "src/**/*.test.ts",
      "src/**/*_test.ts",
      "scripts/**/*.spec.ts",
      "scripts/**/*.test.ts",
      "scripts/**/*_test.ts"
    ]
  }
}
