{
  "tasks": {
    "start": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-run src/main.ts",
    "api:start": "deno run --env --allow-read --allow-write --allow-env --allow-net --allow-ffi --allow-run src/api/server.ts",
    "test": "deno test --env --allow-read --allow-write --allow-env --allow-ffi --allow-run --allow-net",
    "verify": "deno run --allow-env --allow-read --allow-run scripts/verify.ts",
    "verify:integration": "deno run --allow-env --allow-net --allow-ffi --allow-sys scripts/verify_integration.ts",
    "test:smoke": "deno test --env --allow-read --allow-write --allow-env --allow-ffi --allow-run --allow-net tests/smoke.spec.ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:setup": "deno run --env --allow-read --allow-env --allow-net src/core/db/setup.ts",
    "gui:start": "npm --prefix gui run dev"
  },
  "imports": {
    "@mastra/core": "npm:@mastra/core@^1.0.0",
    "@ai-sdk/google": "npm:@ai-sdk/google@^1.0.0",
    "@bubblyworld/highs-ts": "npm:@bubblyworld/highs-ts@^1.2.0",
    "genetic-search": "npm:genetic-search@^1.0.0",
    "javascript-lp-solver": "npm:javascript-lp-solver@1.0.3",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "zod": "npm:zod@^3.23.8",
    "@huggingface/transformers": "npm:@huggingface/transformers@^4.2.0",
    "commander": "npm:commander@^12.1.0",
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "pg": "npm:pg@^8.11.3",
    "@types/pg": "npm:@types/pg@^8.11.4",
    "@cliffy/command": "https://deno.land/x/cliffy@v1.0.0-rc.4/command/mod.ts",
    "@cliffy/prompt": "https://deno.land/x/cliffy@v1.0.0-rc.4/prompt/mod.ts",
    "@cliffy/table": "https://deno.land/x/cliffy@v1.0.0-rc.4/table/mod.ts",
    "@cliffy/ansi": "https://deno.land/x/cliffy@v1.0.0-rc.4/ansi/mod.ts",
    "@std/cli": "https://deno.land/std@0.224.0/cli/mod.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "nodeModulesDir": "auto",
  "test": {
    "include": [
      "tests/**/*.spec.ts",
      "tests/**/*.test.ts",
      "tests/**/*_test.ts",
      "src/**/*.spec.ts",
      "src/**/*.test.ts",
      "src/**/*_test.ts",
      "scripts/**/*.spec.ts",
      "scripts/**/*.test.ts",
      "scripts/**/*_test.ts"
    ]
  }
}
